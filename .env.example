# ─── Database (cPanel → MySQL Databases) ────────────────────────────────────
# On shared hosting the database name and user are usually prefixed with your
# account name, e.g. "pbuser_travel" and "pbuser_pb".
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=pbuser_pb
DB_PASSWORD=change-me
DB_NAME=pb_travel_diaries
# If connections to 127.0.0.1 are refused, use the MySQL socket instead:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ─── Server ─────────────────────────────────────────────────────────────────
# Passenger/cPanel supplies its own PORT; leave this alone there.
PORT=4000
NODE_ENV=production
# Where uploads are written. Back this folder up.
MEDIA_DIR=./media
DIST_DIR=./dist

# ─── Sessions ───────────────────────────────────────────────────────────────
SESSION_DAYS=7
# "auto" = Secure cookie whenever the request is HTTPS.
COOKIE_SECURE=auto
# Behind Passenger/Apache this must stay true or every visitor looks local.
TRUST_PROXY=true

# ─── Security ───────────────────────────────────────────────────────────────
# bcrypt work factor. 10 is sensible on shared hosting; use 12 on a VPS.
BCRYPT_ROUNDS=10
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=240
# Leave false: new accounts are created from the dashboard instead.
ALLOW_PUBLIC_SIGNUP=false
