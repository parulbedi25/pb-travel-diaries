# ─── Database (created in your hosting panel first) ──────────────────────────
# Optional: the setup screen can save these to data/install.json instead. If
# you do fill them in, they win over the installer's file and the setup screen
# skips its database step.
# On shared hosting the database name and user are usually prefixed with your
# account name, e.g. "pbuser_travel" and "pbuser_pb".
# Uncomment and fill these in to configure the database from the environment.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=pbuser_pb
# DB_PASSWORD=change-me
# DB_NAME=pb_travel_diaries
# If connections to 127.0.0.1 are refused, use the MySQL socket instead:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# ─── Server ─────────────────────────────────────────────────────────────────
# Passenger supplies its own PORT; leave this alone there.
PORT=4000
NODE_ENV=production
# Where uploads are written. Back this folder up.
MEDIA_DIR=./media
DIST_DIR=./dist

# ─── Sessions ───────────────────────────────────────────────────────────────
SESSION_DAYS=7
# "auto" = Secure cookie whenever the request is HTTPS.
COOKIE_SECURE=auto
# Behind Passenger/Apache this must stay true or every visitor looks local.
TRUST_PROXY=true

# Where the setup screen saves the database password. Keep it outside the web
# root and back it up.
# INSTALL_FILE=./data/install.json

# ─── Backups ────────────────────────────────────────────────────────────────
# A zip is written every day at BACKUP_HOUR into BACKUP_DIR (created if it does
# not exist), and only the newest BACKUP_KEEP are kept. Each one holds the
# database as a standalone pb-restore.json importer, every uploaded file, and
# the application itself.
BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_KEEP=10
# BACKUP_DIR=./backup
# Set to false to leave the code out of the archive (media + data only).
BACKUP_INCLUDE_APP=true
# Largest backup the restore screen will accept, in MB.
MAX_RESTORE_MB=2048

# ─── Security ───────────────────────────────────────────────────────────────
# bcrypt work factor. 10 is sensible on shared hosting; use 12 on a VPS.
BCRYPT_ROUNDS=10
MAX_UPLOAD_MB=25
RATE_LIMIT_PER_MINUTE=240
# Fallback only: once installed, the dashboard's "Allow public sign-up" setting
# (Settings → Site & sign-up) decides. When it is on, sign-ups become readers.
ALLOW_PUBLIC_SIGNUP=false
