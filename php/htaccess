# The page and its API live in the same folder. Every /api/… request goes to
# api.php, which is the whole server for a host that runs PHP but not Node.
#
# Apache on shared hosting reads this file automatically. If your host calls it
# something else (some panels hide dotfiles), ask support to enable
# "Pretty URLs" — or upload it renamed to `.htaccess` yourself.

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Real files win: index.html, images/, media/, mobile-layout.css, the worker.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything under /api/ is the bridge.
  RewriteRule ^api/(.*)$ api.php [QSA,L]

  # /api without a slash too.
  RewriteRule ^api$ api.php [QSA,L]
</IfModule>

# Belt and braces for the case where mod_rewrite is missing and the request
# arrives as /api/setup/status — one file, one entry point.
<IfModule mod_alias.c>
  # Nothing to do here; kept so a host without rewrite still serves the page.
</IfModule>

# The configuration file holds the database password. It is executed by PHP, so
# its source is never served — but deny it by name as well, in case the server
# ever stops executing PHP in this folder.
<FilesMatch "^php-config\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Dotfiles are nobody's business: .env, .git, editors' leftovers.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# The page is one file that changes only when the site is exported again.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
