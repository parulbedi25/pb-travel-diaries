# Firebase build and deployment files
/firebase-debug.log
/firebase-debug.*.log
.firebaserc

# Firebase Hosting
/firebase.json
*.cache
hosting/.cache

# Firebase Functions
/functions/node_modules/
/functions/.env
/functions/package-lock.json

# Firebase Emulators
/firebase-*.zip
/.firebase/
/emulator-ui/

# Dependencies and generated output
/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (local configs)
/.env.*
!.env.example
!.env.development.example
!.env.production.example

# Uploaded media: content, not code. Back it up, don't commit it.
media/*
!media/README.md
!media/.gitkeep

# Server configuration (database password lives here)
.env
.env.local

# SQLite/MariaDB scratch files
*.sqlite
*.sqlite3

# Local scratch (test harnesses, PR bodies)
/.s/

# First-run installer answers (database password lives here)
/data/

# The deployable folder produced by `npm run package`
/release/

# The daily backups: database dumps with password hashes and media. They live
# on the server, not in the repository.
/backup/

# Disposable deployment diagnostics
/test-results/

# Committed template only; .env.test itself stays private
!.env.test.example
