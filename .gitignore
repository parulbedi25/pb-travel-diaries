# Firebase build and deployment files
/firebase-debug.log
/firebase-debug.*.log
.firebaserc

# Firebase Hosting
/firebase.json
*.cache
hosting/.cache

# Firebase Functions
/functions/node_modules/
/functions/.env
/functions/package-lock.json

# Firebase Emulators
/firebase-*.zip
/.firebase/
/emulator-ui/

# Dependencies and generated output
/node_modules/

# Copies of public/ that Vite writes into dist/. Only the single-file page is
# tracked; these are rebuilt every time.
/dist/images/
/dist/media/
/dist/mobile-layout.css
# Copied in from public/ by the build; the server serves public/ directly, so
# only the single-file page needs to be tracked.
/dist/maplibre-gl-worker.mjs

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (local configs)
/.env.*
!.env.example
!.env.development.example
!.env.production.example

# Uploaded media: content, not code. Back it up, don't commit it.
media/*
!media/README.md
!media/.gitkeep

# Server configuration (database password lives here)
.env
.env.local

# SQLite/MariaDB scratch files
*.sqlite
*.sqlite3

# Local scratch (test harnesses, PR bodies)
/.s/

# First-run installer answers (database password lives here)
/data/

# The deployable folder produced by `npm run package`
/release/

# The daily backups: database dumps with password hashes and media. They live
# on the server, not in the repository.
/backup/

# Disposable deployment diagnostics
/test-results/

# Committed template only; .env.test itself stays private
!.env.test.example

# Persistent embedded SQLite storage
/server/data/
/build.html
# vite.config.mjs is committed on purpose: a build without the Tailwind plugin
# in it produces a site with all its markup and almost none of its styling.
