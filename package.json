  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
