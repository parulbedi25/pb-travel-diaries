{
  "name": "pb-travel-diaries",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch app.cjs",
    "start": "node app.cjs",
    "package": "node server/scripts/package.js",
    "prod": "node app.cjs",
    "db:init": "node server/scripts/init-db.js",
    "test:server": "node --test server/tests/*.test.js",
    "audit": "npm audit --audit-level=high",
